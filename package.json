    "leaflet": "^1.9.4",
    "lucide-react": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
